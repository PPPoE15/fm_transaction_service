WEB_SERVICE_NAME=fm_transaction_service

# База данных

DB_HOST="db"
DB_PORT=5432
DB_USERNAME="postgres"
DB_DATABASE="fm_transaction_service"
DB_PASSWORD="password"
DB_ECHO=0

# Проверка подписи JWT: публичный ключ сервиса авторизации (PEM). В docker-окружении монтируется как secret
WEB_PUBLIC_KEY_PATH="/run/secrets/jwt_public_key"
WEB_TOKEN_SIGNING_ALGORITHM="RS256"
